pal ../../../examples/palette.pal
# Low-poly Alpine Wildflower Cluster (poppy, daisy & marigold on grassy stems)
# Small meadow grass base
pyr @g1 grass_dark  -.08,-.04,.06   .11,.42,.04  r=26,42,20   a=b
pyr @g2 grass_mid    .10,-.04,.05   .10,.38,.04  r=24,-38,-22 a=b
pyr @g3 grass_light  .02,-.04,-.10  .11,.44,.04  r=-28,15,-14 a=b
pyr @g4 moss_mid    -.11,-.04,-.07  .10,.36,.04  r=-22,-55,24 a=b

# 1. White Alpine Daisy (tallest, leaning slightly left-front — 6 crisp petals anchored cleanly in center)
cyl @s_daisy grass_dark -.12,-.03,.08 .024,.018,.78 r=14,0,12 a=b seg=5
grp @fl_daisy -.25,.70,.24 r=18,15,14
  ico fox_light   0,.03,0   .072 s=1.1,.55,1.1 sub=0
  box fox_cream   .10,.02,0    .14,.022,.065 r=0,0,10   bev=.004
  box fox_cream  -.10,.02,0    .14,.022,.065 r=0,0,-10  bev=.004
  box fox_cream   .05,.02,.087 .14,.022,.065 r=0,-60,10 bev=.004
  box fox_cream  -.05,.02,-.087 .14,.022,.065 r=0,-60,-10 bev=.004
  box fox_cream  -.05,.02,.087 .14,.022,.065 r=0,60,-10 bev=.004
  box fox_cream   .05,.02,-.087 .14,.022,.065 r=0,60,10 bev=.004
end

# 2. Crimson Alpine Poppy (mid-height, leaning right)
cyl @s_poppy grass_mid .14,-.03,.02 .024,.018,.68 r=8,0,-16 a=b seg=5
grp @fl_poppy .30,.60,.10 r=10,-20,-18
  ico wood_dark   0,.04,0   .060 s=1.0,.8,1.0 sub=0
  box red_paint   .09,.05,0   .13,.025,.12 r=0,0,38  bev=.005
  box red_paint  -.09,.05,0   .13,.025,.12 r=0,0,-38 bev=.005
  box red_paint   0,.05,.09   .12,.025,.13 r=-38,0,0 bev=.005
  box red_paint   0,.05,-.09  .12,.025,.13 r=38,0,0  bev=.005
end

# 3. Golden Marigold (compact, back-center)
cyl @s_gold grass_dark -.02,-.03,-.12 .022,.016,.58 r=-16,0,-4 a=b seg=5
grp @fl_gold .02,.52,-.26 r=-18,24,-6
  ico fox_orange  0,.03,0   .058 s=1.1,.6,1.1 sub=0
  box fox_light   .08,.02,0   .11,.025,.09 r=0,0,22  bev=.004
  box fox_light  -.08,.02,0   .11,.025,.09 r=0,0,-22 bev=.004
  box fox_light   0,.02,.08   .09,.025,.11 r=-22,0,0 bev=.004
  box fox_light   0,.02,-.08  .09,.025,.11 r=22,0,0  bev=.004
end
