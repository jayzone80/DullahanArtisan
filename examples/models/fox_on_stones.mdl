pal ../palette.pal
# Stylized Red Fox on Boolean-Carved Mossy Stones (SDF Surface-Nets Metaballs + Exact BSP CSG)
$fy=.58

# 1. Boolean-carved ancient mossy stone plinth (exact BSP CSG with dark carved interior faces)
csg @stones
  box stone_mid    0,.19,0          1.60,.38,1.40  bev=.04
  add box stone_light -.05,.46,-.04 1.14,.24,1.04  r=0,6,0 bev=.035
  # Crisp CSG cutouts: front stone arch, circular carved basin on lower ledge & weathered back chips
  sub cyl stone_dark  -.28,.04,.62  .22,.22,.44    r=90,0,0 seg=10
  sub cyl stone_dark   .56,.38,.44  .16,.16,.16    seg=12
  sub box stone_dark  -.76,.32,-.56 .42,.34,.42    r=14,-24,0
  sub box stone_dark   .66,.54,-.50 .36,.26,.36    r=-12,24,0
end

# Moss cushions, grass tufts & small fallen pebbles grounded cleanly on ledges
ico @moss_l  moss_mid   -.56,.39,.24  .14  s=1.4,.40,1.1  sub=1 jit=.18 seed=3
ico @moss_r  moss_mid    .54,.39,-.18 .13  s=1.3,.38,1.2  sub=1 jit=.20 seed=7
ico @moss_b  grass_dark -.32,.59,-.40 .12  s=1.5,.34,.95  sub=1 jit=.16 seed=11
ico @peb_1   stone_light .76,.06,.50  .11  s=1.3,.60,.95  sub=1 jit=.15 seed=5
ico @peb_2   stone_mid  -.76,.05,-.44 .09  s=1.2,.55,1.1  sub=1 jit=.18 seed=9
# Stylized grass blades sprouting beside the moss patches
wdg @tuft_1  grass_light -.58,.41,.28  .04,.16,.04 r=10,20,12 a=b
wdg @tuft_2  grass_mid   -.51,.41,.31  .035,.13,.035 r=-8,65,-14 a=b
wdg @tuft_3  grass_light  .58,.41,-.14 .04,.15,.04 r=12,-40,10 a=b

# 2. Sitting Red Fox sculpted via SDF Surface-Nets Metaballs (smooth blends + paint markings)
sdf @fox res=38 sm=1
  # Seated haunches, upright spine, chest & neck
  ell fox_orange   0,$fy+.20,-.12    .23,.21,.26
  ell fox_orange   .17,$fy+.16,-.06  .13,.16,.21   r=-12,14,0 k=.08 m=x
  cap fox_orange   0,$fy+.20,-.10    0,$fy+.54,.08 .21,.165   k=.10
  ell fox_cream    0,$fy+.43,.16     .16,.17,.13   k=.07
  cap fox_orange   0,$fy+.53,.08     0,$fy+.75,.14 .13,.105   k=.08

  # Front legs & charcoal stockings/paws planted on top stone
  cap fox_orange   .105,$fy+.46,.12  .085,$fy+.23,.19  .072,.050  k=.06 m=x
  cap fox_charcoal .085,$fy+.23,.19  .080,$fy+.05,.21  .049,.040  k=.03 m=x
  ell fox_charcoal .080,$fy+.04,.245 .052,.038,.070               k=.025 m=x
  # Tucked hind paws beside haunches
  ell fox_charcoal .185,$fy+.04,.07  .052,.038,.080               k=.03 m=x

  # Sleek foxy diamond head, fluffy white cheeks, slender pointed snout & big ears
  ell fox_orange   0,$fy+.81,.15     .165,.145,.175               k=.06
  ell fox_cream    .105,$fy+.765,.18 .092,.075,.095 r=0,-20,6     k=.06 m=x
  cap fox_orange   0,$fy+.79,.22     0,$fy+.74,.465 .094,.036     k=.05
  cap fox_cream    0,$fy+.735,.23    0,$fy+.72,.445 .068,.028     k=.04
  sph fox_charcoal 0,$fy+.748,.485   .032                         k=.012

  # Tall pointed triangular ears with clean cream inner hollows & dark tips
  cap fox_orange   .10,$fy+.89,.12   .175,$fy+1.14,.09  .076,.024 k=.035 m=x
  sub ell fox_cream .12,$fy+.955,.165 .034,.065,.032 r=10,16,-14  k=.012 m=x
  paint fox_charcoal sph .185,$fy+1.14,.09 .085                   m=x

  # Gentle eye sockets
  sub sph fox_dark .082,$fy+.835,.282 .030                        k=.01 m=x

  # Lush curled bushy tail wrapping around the right flank with white tip
  cap fox_orange   0,$fy+.14,-.28    .22,$fy+.14,-.34   .105,.15  k=.08
  cap fox_orange   .22,$fy+.14,-.34  .41,$fy+.16,-.08   .15,.175  k=.09
  cap fox_orange   .41,$fy+.16,-.08  .35,$fy+.14,.21    .165,.13  k=.08
  cap fox_cream    .35,$fy+.14,.21   .22,$fy+.12,.35    .125,.050 k=.06

  # Clean organic fur markings via geometry-preserving paint volumes
  paint fox_cream  ell 0,$fy+.37,.20   .14,.19,.11
  paint fox_light  ell 0,$fy+.54,-.02  .15,.19,.17
  paint fox_charcoal cap .085,$fy+.21,.19 .080,$fy+.02,.24 .068,.075 m=x
end

# Warm dark glossy eyes with subtle cream catchlights
ico @eyes  fox_charcoal .080,$fy+.832,.284 .027 sub=1 sm=1 m=x
ico @glint roof_cream   .088,$fy+.842,.304 .009 sub=1 m=x

# 3. Simplified physics collider exported as a separate child glTF node (Godot -convcolonly)
col fox_on_stones-convcolonly
  box 0,.28,0  1.66,.56,1.46
  cap 0,$fy+.58,0 .34,1.16
end
